# GitGud Local Development Environment Variables
# Copy this file to .env and adjust values as needed

# Database Configuration
POSTGRES_DB=gitgud
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/gitgud

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=/

# Keycloak Configuration
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak_admin
KEYCLOAK_DB_PASSWORD=keycloak_password
KEYCLOAK_DB_PORT=5433
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=password
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=gitgud
KEYCLOAK_CLIENT_ID=gitgud-backend
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/gitgud
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/gitgud/protocol/openid-connect/certs

# Backend Configuration
BACKEND_PORT=8080
ROOT_LOG_LEVEL=DEBUG
GITGUD_LOG_LEVEL=DEBUG
WEB_LOG_LEVEL=DEBUG
SQL_LOG_LEVEL=DEBUG
SQL_BINDER_LOG_LEVEL=TRACE
ACTIVE_PROFILE=dev

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api

# JWT Configuration (for local development)
JWT_SECRET=jwt-secret
JWT_EXPIRATION_MS=86400000

# OAuth Providers (Google, GitHub)
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# Code Execution Configuration
CODE_EXECUTION_TIMEOUT_SECONDS=5
CODE_EXECUTION_MAX_MEMORY_MB=256
CODE_EXECUTION_DOCKER_IMAGE=gitgud-java-executor:latest

# Observability Configuration
# Loki (Log Aggregation)
LOKI_HOST=localhost
LOKI_PORT=3100
LOKI_URL=http://localhost:3100

# Prometheus (Metrics Collection)
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://localhost:9090

# Grafana (Visualization)
GRAFANA_HOST=localhost
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password