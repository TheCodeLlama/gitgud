# GitGud Local Development Environment Variables
# Copy this file to .env and adjust values as needed

# Database Configuration
POSTGRES_DB=gitgud
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/gitgud

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=/

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef
FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# Firebase Admin SDK - Choose ONE option:
# Option A: File path (relative to backend/src/main/resources/)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase/service-account.json
# Option B: Base64-encoded service account JSON (recommended for production)
# FIREBASE_SERVICE_ACCOUNT_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsC...

# Backend Configuration
BACKEND_PORT=8080
ROOT_LOG_LEVEL=DEBUG
GITGUD_LOG_LEVEL=DEBUG
WEB_LOG_LEVEL=DEBUG
SQL_LOG_LEVEL=DEBUG
SQL_BINDER_LOG_LEVEL=TRACE
ACTIVE_PROFILE=dev

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Code Execution Configuration
CODE_EXECUTION_TIMEOUT_SECONDS=5
CODE_EXECUTION_MAX_MEMORY_MB=256
CODE_EXECUTION_DOCKER_IMAGE=gitgud-java-executor:latest

# Observability Configuration
# Loki (Log Aggregation)
LOKI_HOST=localhost
LOKI_PORT=3100
LOKI_URL=http://localhost:3100

# Prometheus (Metrics Collection)
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://localhost:9090

# Grafana (Visualization)
GRAFANA_HOST=localhost
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password