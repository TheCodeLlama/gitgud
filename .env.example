# GitGud Local Development Environment Variables
# Copy this file to .env and adjust values as needed

# Database Configuration
POSTGRES_DB=gitgud
POSTGRES_USER=gitgud_user
POSTGRES_PASSWORD=gitgud_dev_password
DATABASE_URL=jdbc:postgresql://localhost:5432/gitgud

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=gitgud_user
RABBITMQ_PASSWORD=gitgud_dev_password
RABBITMQ_VHOST=/

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=gitgud
KEYCLOAK_CLIENT_ID=gitgud-backend
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Backend Service Ports (when running locally via IDE)
API_GATEWAY_PORT=8080
LEARNING_SERVICE_PORT=8081
GAMIFICATION_SERVICE_PORT=8082
CODE_EXECUTION_SERVICE_PORT=8083

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api

# JWT Configuration (for local development)
JWT_SECRET=your-local-jwt-secret-change-in-production
JWT_EXPIRATION_MS=86400000

# OAuth Providers (Google, GitHub)
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# Code Execution Configuration
CODE_EXECUTION_TIMEOUT_SECONDS=5
CODE_EXECUTION_MAX_MEMORY_MB=256
CODE_EXECUTION_DOCKER_IMAGE=openjdk:25-slim

# Logging
LOG_LEVEL=DEBUG
